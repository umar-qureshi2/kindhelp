@page "{id:int}"
@model KindHelp.Web.Pages.Admin.Donors.EditModel
@{
    ViewData["Title"] = "Edit donor";
}

@if (Model.Donor is null)
{
    <h1>Donor not found</h1>
    <a asp-page="/Admin/Donors/Index">&larr; Back</a>
}
else
{
    <h1>Edit donor</h1>
    <p class="muted">@(Model.Donor.ApplicationUserId is not null ? "This donor has a registered account; editing affects only the donor record." : "Admin-managed donor.")</p>

    <form method="post" class="form" style="max-width: 560px;">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <label asp-for="Input.DisplayName">Display name</label>
            <input asp-for="Input.DisplayName" />
        </div>

        <div class="form-grid-2">
            <div class="form-row">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" />
            </div>
            <div class="form-row">
                <label asp-for="Input.PhoneNumber">Phone</label>
                <input asp-for="Input.PhoneNumber" type="tel" />
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.Notes">Admin notes</label>
            <textarea asp-for="Input.Notes" rows="3"></textarea>
        </div>

        <div class="row">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Admin/Donors/Details" asp-route-id="@Model.Donor.Id" class="btn">Cancel</a>
        </div>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
