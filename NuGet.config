<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Project-local NuGet sources for KindHelp.
    The <clear /> wipes any sources inherited from machine-level or user-level NuGet.config
    (e.g. corporate Azure DevOps feeds) so this repo only restores from public nuget.org.
    This file only affects packages restored from THIS folder; it does not touch other projects.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
