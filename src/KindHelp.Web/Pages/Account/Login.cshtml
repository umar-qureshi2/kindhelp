@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <h1>Sign in</h1>
    <p class="muted">Welcome back. Sign in to view your private dashboard.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-row checkbox">
            <label>
                <input asp-for="Input.RememberMe" type="checkbox" />
                Remember me
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Sign in</button>
        <a asp-page="/Account/Register" class="ml-2">Create an account</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
