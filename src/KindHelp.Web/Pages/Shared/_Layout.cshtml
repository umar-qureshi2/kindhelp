@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Config
@{
    var siteName = Config["KindHelp:SiteName"] ?? "KindHelp";
    var tagline = Config["KindHelp:SiteTagline"] ?? "Quiet kindness, real impact.";
    var isAdmin = SignInManager.IsSignedIn(User) && User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"]) · @siteName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Inline theme bootstrap: applies the saved theme before paint so we never flash the wrong one. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('kh-theme');
                if (t === 'light' || t === 'dark') {
                    document.documentElement.setAttribute('data-theme', t);
                }
            } catch (e) { /* localStorage unavailable; fall back to system theme */ }
        })();
    </script>
</head>
<body>
    <header class="site-header">
        <div class="header-row">
            <a class="brand" asp-page="/Index">
                <span class="brand-mark">&#10084;</span>
                <span class="brand-name">@siteName</span>
            </a>
            <nav class="primary-nav">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Cases/Index">Cases</a>
                <a asp-page="/About">About</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-page="/My/Dashboard">Dashboard</a>
                    <a asp-page="/My/Wallet">Wallet</a>
                }
                @if (isAdmin)
                {
                    <a asp-page="/Admin/Index">Admin</a>
                }
            </nav>
            <div class="auth-nav">
                <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle colour theme">
                    <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="who">@User.Identity?.Name</span>
                    <form asp-page="/Account/Logout" method="post" class="inline">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login" class="btn btn-sm">Sign in</a>
                    <a asp-page="/Account/Register" class="btn btn-primary btn-sm">Register</a>
                }
            </div>
        </div>
        <div class="tagline-strip">
            <div class="container">@tagline</div>
        </div>
    </header>

    <main class="main-content">
        @if (TempData["StatusMessage"] is string msg && !string.IsNullOrEmpty(msg))
        {
            <div class="alert alert-info">@msg</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; @DateTime.UtcNow.Year @siteName. Contributions remain private — donors are never visible to other donors.</p>
        </div>
    </footer>

    <script>
        // Toggle is now 2-state (light <-> dark). On first toggle, we commit to a choice
        // and persist it; until then, the page follows the OS theme via prefers-color-scheme.
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var html = document.documentElement;
                var current = html.getAttribute('data-theme');
                if (!current) {
                    // Resolve current effective mode from the system, then flip away from it.
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    current = prefersDark ? 'dark' : 'light';
                }
                var next = current === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                try { localStorage.setItem('kh-theme', next); } catch (e) { }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
