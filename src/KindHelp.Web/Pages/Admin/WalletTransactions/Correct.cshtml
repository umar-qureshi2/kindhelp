@page "{id:int}"
@model KindHelp.Web.Pages.Admin.WalletTransactions.CorrectModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Correct wallet transaction";
    var currency = Config["KindHelp:Currency"] ?? "PKR";
}

@if (Model.Original is null)
{
    <h1>Transaction not found</h1>
    <a asp-page="/Admin/Donors/Index">&larr; Back to donors</a>
}
else
{
    var originalAbs = Math.Abs(Model.Original.Amount);
    var typeLabel = Model.Original.Type.ToString();
    <div class="page-head">
        <div>
            <div class="breadcrumbs muted small">
                <a asp-page="/Admin/Donors/Index">Donors</a> &rsaquo;
                <a asp-page="/Admin/Donors/Details" asp-route-id="@Model.DonorId">@Model.DonorLabel</a> &rsaquo;
                <span>Correct transaction #@Model.Original.Id</span>
            </div>
            <h1>Correct a wallet typo</h1>
            <p class="muted">
                The original entry below stays in the ledger for audit. We'll record a
                compensating adjustment carrying the delta and your reason. If this is an
                allocation, the case's raised total will be updated as well.
            </p>
        </div>
    </div>

    <div class="raise-box" style="max-width: 720px; margin-bottom: 18px;">
        <h3>Original entry</h3>
        <div class="row spaced">
            <div>
                <div class="muted small">Type</div>
                <div><strong>@typeLabel</strong></div>
            </div>
            <div>
                <div class="muted small">Recorded amount</div>
                <div><strong>@originalAbs.ToString("N2") @currency</strong></div>
            </div>
            <div>
                <div class="muted small">Date</div>
                <div>@Model.Original.OccurredAtUtc.ToString("dd MMM yyyy")</div>
            </div>
            @if (Model.Original.CaseId is int caseId)
            {
                <div>
                    <div class="muted small">Case</div>
                    <div>@(Model.Original.Case?.Title ?? ("Case #" + caseId))</div>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Original.Reference))
        {
            <div class="muted small mt-2">Reference: @Model.Original.Reference</div>
        }
    </div>

    <form method="post" class="form" style="max-width: 720px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Input.TransactionId" />

        <div class="form-grid-2">
            <div class="form-row">
                <label asp-for="Input.CorrectedAmount">Corrected amount (@currency)</label>
                <input asp-for="Input.CorrectedAmount" type="number" step="0.01" min="0.01" autofocus />
                <span asp-validation-for="Input.CorrectedAmount" class="text-danger"></span>
                <small>What the amount should have been. Must be positive.</small>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Input.Reason">Reason for the correction</label>
            <textarea asp-for="Input.Reason" rows="3" placeholder="e.g. typed 5,000 instead of 500"></textarea>
            <span asp-validation-for="Input.Reason" class="text-danger"></span>
            <small>Required — appears in the donor's wallet history alongside the adjustment.</small>
        </div>

        <div class="row">
            <button type="submit" class="btn btn-primary">Apply correction</button>
            <a asp-page="/Admin/Donors/Details" asp-route-id="@Model.DonorId" class="btn">Cancel</a>
        </div>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
