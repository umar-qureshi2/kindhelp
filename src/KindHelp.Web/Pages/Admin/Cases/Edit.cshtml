@page "{id:int}"
@model KindHelp.Web.Pages.Admin.Cases.EditModel
@{
    ViewData["Title"] = "Edit case";
}

@if (Model.Case is null)
{
    <h1>Case not found</h1>
    <a asp-page="/Admin/Cases/Index">&larr; Back</a>
}
else
{
    <div class="page-head">
        <h1>Edit case</h1>
        <div>
            <a asp-page="/Admin/Cases/Updates" asp-route-id="@Model.Case.Id" class="btn">Updates</a>
            <a asp-page="/Admin/Cases/Photos" asp-route-id="@Model.Case.Id" class="btn">Photos</a>
            <a asp-page="/Cases/Details" asp-route-slug="@Model.Case.Slug" class="btn" target="_blank">View public</a>
        </div>
    </div>

    <form method="post" class="form">
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <label asp-for="Input.Title"></label>
            <input asp-for="Input.Title" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Input.Slug"></label>
            <input asp-for="Input.Slug" />
            <span asp-validation-for="Input.Slug" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Input.Summary"></label>
            <textarea asp-for="Input.Summary" rows="3"></textarea>
            <span asp-validation-for="Input.Summary" class="text-danger"></span>
        </div>

        <div class="form-row">
            <label asp-for="Input.Description"></label>
            <textarea asp-for="Input.Description" rows="12"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-row">
                <label asp-for="Input.Category"></label>
                <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<KindHelp.Web.Models.CaseCategory>()"></select>
            </div>
            <div class="form-row">
                <label asp-for="Input.Status"></label>
                <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<KindHelp.Web.Models.CaseStatus>()"></select>
            </div>
            <div class="form-row">
                <label asp-for="Input.Location"></label>
                <input asp-for="Input.Location" />
            </div>
            <div class="form-row">
                <label asp-for="Input.GoalAmount"></label>
                <input asp-for="Input.GoalAmount" type="number" step="0.01" />
            </div>
            <div class="form-row">
                <label asp-for="Input.BeneficiaryName"></label>
                <input asp-for="Input.BeneficiaryName" />
            </div>
            <div class="form-row checkbox">
                <label>
                    <input asp-for="Input.ShowBeneficiaryName" type="checkbox" />
                    Show beneficiary name publicly
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="/Admin/Cases/Index" class="ml-2">Back</a>
        <button type="submit" asp-page-handler="Delete" class="btn btn-danger float-right"
                onclick="return confirm('Delete this case? Contributions will block deletion if present.');">Delete case</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
