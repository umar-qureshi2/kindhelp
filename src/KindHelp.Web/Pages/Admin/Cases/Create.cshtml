@page
@model KindHelp.Web.Pages.Admin.Cases.CreateModel
@{
    ViewData["Title"] = "New case";
}

<h1>Create a new case</h1>

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-row">
        <label asp-for="Input.Title"></label>
        <input asp-for="Input.Title" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="form-row">
        <label asp-for="Input.Slug"></label>
        <input asp-for="Input.Slug" placeholder="auto-generated if blank" />
        <span asp-validation-for="Input.Slug" class="text-danger"></span>
    </div>

    <div class="form-row">
        <label asp-for="Input.Summary"></label>
        <textarea asp-for="Input.Summary" rows="3"></textarea>
        <span asp-validation-for="Input.Summary" class="text-danger"></span>
    </div>

    <div class="form-row">
        <label asp-for="Input.Description"></label>
        <textarea asp-for="Input.Description" rows="10"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="form-grid-2">
        <div class="form-row">
            <label asp-for="Input.Category"></label>
            <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<KindHelp.Web.Models.CaseCategory>()"></select>
        </div>
        <div class="form-row">
            <label asp-for="Input.Status"></label>
            <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<KindHelp.Web.Models.CaseStatus>()"></select>
        </div>
        <div class="form-row">
            <label asp-for="Input.Location"></label>
            <input asp-for="Input.Location" />
        </div>
        <div class="form-row">
            <label asp-for="Input.GoalAmount"></label>
            <input asp-for="Input.GoalAmount" type="number" step="0.01" />
        </div>
        <div class="form-row">
            <label asp-for="Input.BeneficiaryName"></label>
            <input asp-for="Input.BeneficiaryName" />
        </div>
        <div class="form-row checkbox">
            <label>
                <input asp-for="Input.ShowBeneficiaryName" type="checkbox" />
                Show beneficiary name publicly
            </label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Create case</button>
    <a asp-page="/Admin/Cases/Index" class="ml-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
