@page
@model KindHelp.Web.Pages.Admin.IndexModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Admin";
    var currency = Config["KindHelp:Currency"] ?? "PKR";
}

<h1>Admin dashboard</h1>

<div class="stat-row">
    <div class="stat-card">
        <div class="stat-label">Total cases</div>
        <div class="stat-value">@Model.TotalCases</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Active</div>
        <div class="stat-value">@Model.ActiveCases</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total raised (all-time)</div>
        <div class="stat-value">@Model.TotalRaised.ToString("N0") <small>@currency</small></div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Donors</div>
        <div class="stat-value">@Model.DonorCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Wallets total (uncommitted)</div>
        <div class="stat-value">@Model.WalletsTotal.ToString("N0") <small>@currency</small></div>
    </div>
</div>

<div class="admin-actions">
    <a asp-page="/Admin/Cases/Create" class="btn btn-primary">+ New case</a>
    <a asp-page="/Admin/Donors/Create" class="btn">+ New donor</a>
    <a asp-page="/Admin/Contributions/Create" class="btn">Allocate to case</a>
    <a asp-page="/Admin/Cases/Index" class="btn btn-ghost">Manage cases</a>
    <a asp-page="/Admin/Donors/Index" class="btn btn-ghost">Manage donors</a>
    <a asp-page="/Admin/Contributions/Index" class="btn btn-ghost">All contributions</a>
</div>
