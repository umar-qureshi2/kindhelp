@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">An error occurred.</h1>

<p>Sorry — something went wrong while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<p>If this keeps happening, please contact a site admin.</p>
