# Save as /etc/kindhelp/env and chmod 600. Never commit real secrets.
# Override appsettings.json values via environment variables (use double underscores).

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=kindhelp;Username=kindhelp;Password=REPLACE_ME

# Default admin user is seeded on first run. Override here for production.
KindHelp__DefaultAdminEmail=admin@kindhelp.example.org
KindHelp__DefaultAdminPassword=REPLACE_WITH_STRONG_PASSWORD

# Currency label
KindHelp__Currency=PKR
